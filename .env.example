# Public site origin (auth redirect and error URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Resume, account, and media API origin.
# Keep for media-service until the PDF upload work lands (MDI-174).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Supabase (local defaults from `supabase status` after `yarn db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Font file lookup at /api/resume/fonts
GOOGLE_FONTS_API_KEY=

# Resume parse/QA; falls back to TEST_KEY if unset
OPENAI_API_KEY=
