# Public site origin (auth redirect and error URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Canonical origin for metadata, robots, and the sitemap. Unset uses https://www.talvio.co.
# SITE_URL=https://www.talvio.co

# Blog read API (lib/blog/server.ts). Server only — never prefix with NEXT_PUBLIC_.
# Origin only, https except for localhost. The token is the landing-page BLOG_READ_TOKEN_TALVIO (at least 32 bytes), never BLOG_WRITE_TOKEN.
# Unset: blog reads report the API as unavailable, never as an empty blog.
# The www host: the apex mdivani.agency redirects, and the client treats a redirect as an outage.
# BLOG_API_BASE_URL=https://www.mdivani.agency
# BLOG_API_TOKEN=

# Media-service origin (documents list + server-side PDF presign).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Supabase (local defaults from `supabase status` after `yarn db:start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=
# Server only — media-service presign (`POST /media/presign/{userId}`).
MEDIA_SERVICE_API_KEY=

MEDIA_API_BASE_URL=http://localhost:3000/dev

# Font file lookup at /api/resume/fonts
GOOGLE_FONTS_API_KEY=
# Optional. Unset uses https://www.googleapis.com
# GOOGLE_FONTS_API_BASE=

# Resume parse/QA; falls back to TEST_KEY if unset
OPENAI_API_KEY=
# Optional. Unset uses https://api.openai.com/v1
# OPENAI_BASE_URL=

# Release flags (lib/flags.ts). true/false; unset uses the beta defaults shown.
# Changing one needs a redeploy: the values are inlined at build time.
# NEXT_PUBLIC_FLAG_BETA_MODE=true
# Serves /pricing and lists it in the sitemap. Off: /pricing redirects (307) to /#whats-free.
# NEXT_PUBLIC_FLAG_PLANS_PAGE=false
# Shows "Buy credits", "Buy More" and "Upgrade Now". Off: /account/credits and /account/upgrade redirect (307) to /account.
# Keep it off until the purchase pages ship: neither route has a page yet.
# NEXT_PUBLIC_FLAG_CREDIT_PURCHASE_UI=false

# Sentry reports only when VERCEL_ENV is "production" (set by Vercel). The DSN is public and defaults to the talvio-web-app project in code; set these only to override.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# Build-time secret for source map upload (Vercel: Production and Preview). Create an org token at
# https://talvio.sentry.io/settings/auth-tokens/ . Unset skips the upload and stack traces stay minified.
# SENTRY_AUTH_TOKEN=
